      <connections xsi:type="grl:LinkRef" source="172" target="165" link="160">
        <label deltaX="30" deltaY="-30"/>
      </connections>
      <connections xsi:type="grl:LinkRef" source="167" target="166" link="161"/>
      <connections xsi:type="grl:LinkRef" source="168" target="166" link="162"/>
      <connections xsi:type="grl:LinkRef" source="170" target="169" link="163"/>
      <connections xsi:type="grl:LinkRef" source="171" target="169" link="164"/>
      <comments description="ECSE 326 - Software Requirements Engineering&#xA;Term: Fall 2026&#xA;Assignment #4 - Warehouse Management Software (WMS) product line&#xA;Team number: 22&#xA;Team members: Janelle Tam, Ralph Azrak, Ziang Wang" x="40" y="480" width="470" height="130"/>
      <comments description="COMMONALITIES (part of every WMS product):&#xA;- Warehouse Management System (root)&#xA;- Product Retrieval (mandatory): every deployment must be able to retrieve products for an order&#xA;- Order Handover (mandatory): every order is packaged by an employee and then handed over&#xA;&#xA;VARIABILITIES:&#xA;- Product Retrieval is an IOR feature group: Robot Retrieval, Manual Retrieval, or both. With both, robots retrieve the high-demand products of the automated zone and employees the remaining products of the manual zone.&#xA;- Order Handover is an XOR feature group: Shipping Delivery or In-Store Pickup, depending on the type of warehouse.&#xA;- Order Queue Sensor is an optional feature: it monitors the current order queue length, which is used to decide which retrieval method or combination of methods to activate.&#xA;&#xA;CROSS-TREE CONSTRAINTS: none are needed. Every configuration allowed by the tree is a meaningful WMS product, and the only dependencies between features (at least one retrieval method, exactly one handover type) are already expressed by the IOR and XOR feature groups. The Order Queue Sensor is most useful when both retrieval methods are deployed, but it is not required by either of them: with a single retrieval method the sensor reading is still used to activate or deactivate that method, so no requires/excludes constraint applies.&#xA;&#xA;Note: activating and deactivating a retrieval method is run-time behaviour, not a feature selection; it is modelled in the use case map (variables robotActive and manualActive)." x="40" y="640" width="1030" height="380"/>
    </specDiagrams>
    <components name="Customer" id="93" contRefs="94" kind="Actor"/>
    <components name="WMS" id="95" contRefs="96"/>
    <components name="Employee" id="97" contRefs="98" kind="Actor"/>
    <components name="Robot" id="99" contRefs="100" kind="Agent"/>
    <components name="Order Queue Sensor" id="101" contRefs="102" kind="Actor"/>
  </urndef>
