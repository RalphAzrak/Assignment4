      <connections xsi:type="ucm.map:NodeConnection" source="104" target="105"/>
      <connections xsi:type="ucm.map:NodeConnection" source="105" target="106"/>
      <connections xsi:type="ucm.map:NodeConnection" source="106" target="107"/>
      <connections xsi:type="ucm.map:NodeConnection" source="107" target="108"/>
      <connections xsi:type="ucm.map:NodeConnection" source="108" target="109">
        <condition label="[robot retrieval]" expression="robotActive &amp;&amp; (inAutomatedZone || !manualActive)"/>
      </connections>
      <connections xsi:type="ucm.map:NodeConnection" source="108" target="111">
        <condition label="[manual retrieval]" expression="!(robotActive &amp;&amp; (inAutomatedZone || !manualActive))"/>
      </connections>
      <connections xsi:type="ucm.map:NodeConnection" source="109" target="110"/>
      <connections xsi:type="ucm.map:NodeConnection" source="110" target="112"/>
      <connections xsi:type="ucm.map:NodeConnection" source="111" target="112"/>
      <connections xsi:type="ucm.map:NodeConnection" source="112" target="113"/>
      <connections xsi:type="ucm.map:NodeConnection" source="113" target="114"/>
      <connections xsi:type="ucm.map:NodeConnection" source="114" target="115"/>
      <connections xsi:type="ucm.map:NodeConnection" source="115" target="116">
        <condition label="[sensor installed]" expression="_GRL_Order_Queue_Sensor == 100" description=""/>
      </connections>
      <connections xsi:type="ucm.map:NodeConnection" source="115" target="118">
        <condition label="[no sensor]" expression="!(_GRL_Order_Queue_Sensor == 100)&#xA;" description=""/>
      </connections>
      <connections xsi:type="ucm.map:NodeConnection" source="116" target="117"/>
      <connections xsi:type="ucm.map:NodeConnection" source="117" target="119"/>
      <connections xsi:type="ucm.map:NodeConnection" source="118" target="119"/>
      <connections xsi:type="ucm.map:NodeConnection" source="119" target="120"/>
      <connections xsi:type="ucm.map:NodeConnection" source="120" target="121">
        <condition label="[more products]" expression="productsRemaining > 0"/>
      </connections>
      <connections xsi:type="ucm.map:NodeConnection" source="121" target="122"/>
      <connections xsi:type="ucm.map:NodeConnection" source="122" target="107"/>
      <connections xsi:type="ucm.map:NodeConnection" source="120" target="123">
        <condition label="[all products retrieved]" expression="productsRemaining &lt;= 0"/>
      </connections>
      <connections xsi:type="ucm.map:NodeConnection" source="123" target="124"/>
      <connections xsi:type="ucm.map:NodeConnection" source="124" target="125">
        <condition label="[shipping delivery]" expression="_GRL_Shipping_Delivery == 100"/>
      </connections>
      <connections xsi:type="ucm.map:NodeConnection" source="124" target="126">
        <condition label="[in-store pickup]" expression="_GRL_In_Store_Pickup == 100"/>
      </connections>
      <connections xsi:type="ucm.map:NodeConnection" source="125" target="127"/>
      <connections xsi:type="ucm.map:NodeConnection" source="126" target="127"/>
      <connections xsi:type="ucm.map:NodeConnection" source="127" target="128"/>
      <connections xsi:type="ucm.map:NodeConnection" source="128" target="129"/>
      <comments description="Code has been specified for the following responsibilities (all in the WMS component):&#xA;- activate retrieval methods: sets robotActive/manualActive from the selected retrieval features and the initial queueLength&#xA;- update inventory: decrements productsRemaining and moves on to the next product (alternates inAutomatedZone)&#xA;- adapt retrieval methods: feedback loop - takes the sensor's newQueueLength and recomputes robotActive/manualActive for the remaining products&#xA;Rule: with both retrieval methods deployed, robots (automated zone, high-demand products) are only activated when queueLength > 10; employees handle the remaining products. With one method deployed, that method is always active.&#xA;Feature (GRL) variables used: _GRL_Robot_Retrieval, _GRL_Manual_Retrieval, _GRL_Order_Queue_Sensor, _GRL_Shipping_Delivery, _GRL_In_Store_Pickup (selected = 100)." x="40" y="1540" width="700" height="220"/>
    </specDiagrams>
