    <strategies name="Robot Retrieval, Shipping Delivery, with Queue Sensor" id="174" description="Feature configuration of a fully automated distribution warehouse: Robot Retrieval is the only retrieval method (Manual Retrieval deselected), orders are handed over to a shipping company, and the optional Order Queue Sensor is deployed.&#xA;Mandatory features (Product Retrieval, Order Handover) are selected automatically by the tool.&#xA;Valid configuration: Warehouse Management System evaluates to 100, exactly one member of the XOR group Order Handover is selected, and at least one member of the IOR group Product Retrieval is selected." group="3">
      <evaluations evaluation="100" qualitativeEvaluation="Satisfied" intElement="152">
        <kpiEvalValueSet/>
      </evaluations>
      <evaluations intElement="153">
        <kpiEvalValueSet/>
      </evaluations>
      <evaluations evaluation="100" qualitativeEvaluation="Satisfied" intElement="155">
        <kpiEvalValueSet/>
      </evaluations>
      <evaluations intElement="156">
        <kpiEvalValueSet/>
      </evaluations>
      <evaluations evaluation="100" qualitativeEvaluation="Satisfied" intElement="157">
        <kpiEvalValueSet/>
      </evaluations>
    </strategies>
    <strategies name="Manual Retrieval, In-Store Pickup, without Queue Sensor" id="175" description="Feature configuration of a small store warehouse: Manual Retrieval is the only retrieval method (Robot Retrieval deselected), orders are prepared for in-store customer pickup, and no Order Queue Sensor is deployed.&#xA;Mandatory features (Product Retrieval, Order Handover) are selected automatically by the tool.&#xA;Valid configuration: Warehouse Management System evaluates to 100, exactly one member of the XOR group Order Handover is selected, and at least one member of the IOR group Product Retrieval is selected." group="3">
      <evaluations intElement="152">
        <kpiEvalValueSet/>
      </evaluations>
      <evaluations evaluation="100" qualitativeEvaluation="Satisfied" intElement="153">
        <kpiEvalValueSet/>
      </evaluations>
      <evaluations intElement="155">
        <kpiEvalValueSet/>
      </evaluations>
      <evaluations evaluation="100" qualitativeEvaluation="Satisfied" intElement="156">
        <kpiEvalValueSet/>
      </evaluations>
      <evaluations intElement="157">
        <kpiEvalValueSet/>
      </evaluations>
    </strategies>
